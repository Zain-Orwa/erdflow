# Generated by packaging/packaging.cmake from
# packaging/notices/write-notices.cmake.in.
#
# Writes THIRD-PARTY-LICENSES.txt into the package folder ERDFLOW_NOTICES_ROOT
# (packaging/notices/package_notices.py), and the package inventory beside this
# file. macOS and Windows run it during installation; for Linux it is run on the
# AppDir once linuxdeploy has added the libraries:
#
#   cmake -D ERDFLOW_NOTICES_ROOT=<AppDir> -P <build>/packaging/write-notices.cmake

if(NOT ERDFLOW_NOTICES_ROOT OR NOT IS_DIRECTORY "${ERDFLOW_NOTICES_ROOT}")
    message(FATAL_ERROR "write-notices: no package folder at '${ERDFLOW_NOTICES_ROOT}'")
endif()

execute_process(
    COMMAND "@Python3_EXECUTABLE@" "@ERDFLOW_NOTICES_SCRIPT@"
        --root "${ERDFLOW_NOTICES_ROOT}"
        --qt-prefix "@QT6_INSTALL_PREFIX@"
        --output "${ERDFLOW_NOTICES_ROOT}/@ERDFLOW_NOTICES_DIR@/THIRD-PARTY-LICENSES.txt"
        --inventory "@CMAKE_BINARY_DIR@/packaging/inventory.json"
        --title "ERDFlow @PROJECT_VERSION@"
        --application "@ERDFLOW_NOTICES_APPLICATION@"
        @ERDFLOW_NOTICES_ARGUMENTS@
    RESULT_VARIABLE erdflow_notices_status)
if(NOT erdflow_notices_status EQUAL 0)
    message(FATAL_ERROR "write-notices: the package contains components whose licences are not established (listed above)")
endif()
