// The Windows executable's icon and version details, compiled in only when
// ERDFLOW_PACKAGING is on. Configured by packaging/packaging.cmake.
#include <winver.h>

IDI_ICON1 ICON "@ERDFLOW_WINDOWS_ICON@"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "ERDFlow"
            VALUE "FileDescription", "ERDFlow"
            VALUE "FileVersion", "@PROJECT_VERSION@"
            VALUE "InternalName", "erdflow"
            VALUE "LegalCopyright", "@ERDFLOW_COPYRIGHT@"
            VALUE "OriginalFilename", "erdflow.exe"
            VALUE "ProductName", "ERDFlow"
            VALUE "ProductVersion", "@PROJECT_VERSION@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
